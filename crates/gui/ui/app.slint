import { ListView, ScrollView, Button, Switch, ComboBox } from "std-widgets.slint";

// Bundled IBM Plex Sans (SIL OFL). A bare file import registers the font at
// compile time so "IBM Plex Sans" is available as a font-family.
import "../assets/fonts/IBMPlexSans-400.ttf";
import "../assets/fonts/IBMPlexSans-500.ttf";
import "../assets/fonts/IBMPlexSans-600.ttf";
import "../assets/fonts/IBMPlexSans-700.ttf";

// One row in the results column: a headword plus a one-line preview.
struct ResultItem {
    headword: string,
    snippet: string,
    source: string,
}

// One row in the settings dictionary list.
struct DictRow {
    name: string,
    words: string,
    enabled: bool,
    language: int,  // 0 = Auto, 1 = English, 2 = French
}

// One block of a definition body: a paragraph (number == 0) or a numbered sense.
// The body is a list of these so it can be rendered in a virtualized ListView.
struct DefBlock {
    number: int,
    text: string,
}

// One conjugated form (e.g. "past" / "went", or "je" / "parle").
struct ConjForm {
    label: string,
    text: string,
}

// One mood/tense block of a conjugation (English: "Principal parts"; French:
// "Indicatif présent", …).
struct ConjSection {
    label: string,
    forms: [ConjForm],
}

// Read-only text that the user can still select and copy (plain Text can't be
// selected in Slint).
component SelectableText inherits TextInput {
    read-only: true;
    single-line: false;
    wrap: word-wrap;
}

export component AppWindow inherits Window {
    title: "irondict";
    preferred-width: 920px;
    preferred-height: 560px;
    min-width: 640px;
    min-height: 420px;
    default-font-family: "IBM Plex Sans";
    default-font-size: 14px;
    background: bg;

    // ---- theming (accent + dark come from the OS, via Rust) ----
    // `os-accent` is the raw OS accent (defaults to indigo); `dark` mirrors the
    // OS light/dark preference. Everything else is derived so the whole palette
    // flips with one boolean.
    in property <color> os-accent: #4f46e5;
    in property <bool> dark: false;

    // Accent is brightened a touch in dark mode so it stays legible as text/lines
    // against a dark background; the tint is a translucent wash that reads
    // correctly over whatever background it is drawn on.
    property <color> accent: dark ? os-accent.brighter(0.35) : os-accent;
    property <color> accent-tint: accent.with-alpha(dark ? 0.22 : 0.12);

    property <color> bg: dark ? #1d1d20 : #ffffff;
    property <color> control-bg: dark ? #2c2c30 : #ffffff;
    property <color> text-primary: dark ? #f2f2f4 : #1c1c1e;
    property <color> text-secondary: dark ? #98989e : #8a8a8e;
    property <color> divider: dark ? #38383c : #ececec;
    property <color> toolbar-bg: dark ? #252528 : #fafafa;

    // ---- state (driven by Rust) ----
    in-out property <string> query;
    in property <[ResultItem]> results;
    in-out property <int> selected-index: 0;
    in property <bool> searching: false;
    in property <bool> index-ready: false;
    in property <int> scope: 0;            // 0 = All, 1.. = one per dictionary
    in property <[string]> scopes: ["All"]; // segment labels (driven by Rust)

    in property <string> section-label;    // e.g. "WORD OF THE MOMENT"
    in property <string> def-headword;
    in property <string> def-pron;         // pronunciation respelling
    in property <string> def-pos;          // expanded part of speech
    in property <[DefBlock]> def-blocks;   // definition body (paragraphs / senses)
    in property <string> def-source;

    // conjugation table (empty = the entry isn't a recognized verb). Shown only
    // on demand, in an overlay, via the button on a verb's page.
    in property <[ConjSection]> conjugation;
    in-out property <bool> show-conjugation: false;

    // ---- settings page ----
    in-out property <bool> show-settings: false;
    in property <[DictRow]> dict-items;
    in property <int> theme-mode: 0;          // 0 System, 1 Light, 2 Dark
    in property <[color]> accent-swatches;
    in property <int> accent-choice: 0;       // 0 System, n = swatch n-1

    callback query-changed(string);
    callback select(int);
    callback scope-changed(int);

    callback open-settings();
    callback close-settings();
    callback toggle-dict(int);
    callback set-dict-language(int, int);
    callback remove-dict(int);
    callback add-dict();
    callback set-theme-mode(int);
    callback set-accent(int);

    // Focus the search field on launch; global shortcuts still bubble up to the
    // FocusScope below.
    forward-focus: search-input;
    init => {
        search-input.focus();
    }

    FocusScope {
        // Ctrl+1 = All, Ctrl+2 = first dictionary, …; Ctrl+Tab cycles.
        key-pressed(event) => {
            if (event.modifiers.control && event.text >= "1" && event.text <= "9") {
                // text is a single digit here; map "1" → index 0, etc.
                root.scope-changed(event.text.to-float() - 1);
                return EventResult.accept;
            }
            if (event.modifiers.control && event.text == Key.Tab) {
                root.scope-changed(Math.mod(root.scope + 1, root.scopes.length));
                return EventResult.accept;
            }
            return EventResult.reject;
        }

        VerticalLayout {
        // ===================== toolbar =====================
        Rectangle {
            height: 52px;
            background: toolbar-bg;

            // scope segmented control (left) — one segment per scope label,
            // sized to its contents so it grows as dictionaries are added.
            Rectangle {
                x: 16px;
                y: (parent.height - self.height) / 2;
                height: 30px;
                width: scope-row.preferred-width;
                border-radius: 8px;
                background: control-bg;
                border-width: 1px;
                border-color: divider;
                scope-row := HorizontalLayout {
                    padding: 3px;
                    spacing: 2px;
                    for seg[idx] in root.scopes: Rectangle {
                        max-width: 180px;
                        border-radius: 6px;
                        background: scope == idx ? accent : transparent;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            Text {
                                text: seg;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                font-size: 13px;
                                font-weight: scope == idx ? 600 : 400;
                                color: scope == idx ? #ffffff : text-secondary;
                                overflow: elide;
                            }
                        }
                        TouchArea {
                            clicked => { root.scope-changed(idx); }
                        }
                    }
                }
            }

            // settings gear (far right)
            Rectangle {
                x: parent.width - self.width - 16px;
                y: (parent.height - self.height) / 2;
                width: 32px;
                height: 32px;
                border-radius: 8px;
                background: gear-touch.has-hover ? divider : transparent;
                gear-touch := TouchArea {
                    clicked => { root.open-settings(); }
                }
                Text {
                    text: "⚙";
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    font-size: 18px;
                    color: text-secondary;
                }
            }

            // search field (right, left of the gear)
            Rectangle {
                x: parent.width - self.width - 16px - 32px - 10px;
                y: (parent.height - self.height) / 2;
                height: 32px;
                width: 260px;
                border-radius: 8px;
                background: control-bg;
                border-width: 1px;
                border-color: search-input.has-focus ? accent : divider;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 6px;
                    Text {
                        text: "⌕";
                        vertical-alignment: center;
                        font-size: 17px;
                        color: text-secondary;
                    }
                    Rectangle {
                        search-input := TextInput {
                            vertical-alignment: center;
                            font-size: 14px;
                            color: text-primary;
                            single-line: true;
                            text <=> root.query;
                            edited => { root.query-changed(self.text); }
                        }
                        Text {
                            visible: root.query == "";
                            text: root.index-ready ? "Search…" : "Indexing…";
                            vertical-alignment: center;
                            font-size: 14px;
                            color: text-secondary;
                        }
                    }
                }
            }

            // bottom hairline
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: divider;
            }
        }

        // ===================== body =====================
        HorizontalLayout {
            // results column (always visible)
            Rectangle {
                width: 244px;
                background: bg;
                ListView {
                    for item[i] in results: Rectangle {
                        height: 60px;
                        background: i == root.selected-index ? accent-tint : transparent;

                        // accent left bar on the selected row
                        Rectangle {
                            x: 0;
                            width: 3px;
                            background: i == root.selected-index ? accent : transparent;
                        }
                        TouchArea {
                            clicked => { root.select(i); }
                        }
                        VerticalLayout {
                            padding-left: 17px;
                            padding-right: 12px;
                            padding-top: 11px;
                            padding-bottom: 11px;
                            spacing: 3px;
                            Text {
                                text: item.headword;
                                font-size: 14px;
                                font-weight: 500;
                                color: text-primary;
                                overflow: elide;
                            }
                            Text {
                                text: item.snippet;
                                font-size: 12px;
                                color: text-secondary;
                                overflow: elide;
                            }
                        }
                    }
                }

                // divider between list and definition
                Rectangle {
                    x: parent.width - 1px;
                    width: 1px;
                    background: divider;
                }
            }

            // definition pane (the hero). The header/pill stay fixed; only the
            // body scrolls — and it is a ListView so huge entries (e.g. 60 KB
            // HTML dictionary entries) are virtualized and stay at 60fps.
            Rectangle {
                horizontal-stretch: 1;
                background: bg;
                VerticalLayout {
                    padding-left: 40px;
                    padding-right: 40px;
                    padding-top: 36px;
                    padding-bottom: 28px;
                    spacing: 10px;

                    Text {
                        visible: section-label != "";
                        text: section-label;
                        color: accent;
                        font-size: 11px;
                        font-weight: 600;
                    }
                    SelectableText {
                        text: def-headword;
                        font-size: 30px;
                        font-weight: 600;
                        color: text-primary;
                    }
                    // part of speech + pronunciation on one grey line
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        visible: def-pos != "" || def-pron != "";
                        Text {
                            visible: def-pos != "";
                            text: def-pos;
                            font-size: 13px;
                            font-italic: true;
                            color: text-secondary;
                        }
                        Text {
                            visible: def-pron != "";
                            text: "· " + def-pron;
                            font-size: 13px;
                            color: text-secondary;
                        }
                    }

                    // conjugation button (verbs only): opens the full tables in
                    // an overlay so they never crowd out the definition body.
                    HorizontalLayout {
                        alignment: start;
                        visible: conjugation.length > 0;
                        Rectangle {
                            height: 30px;
                            horizontal-stretch: 0;
                            border-radius: 8px;
                            background: conj-btn.has-hover ? accent : accent-tint;
                            border-width: 1px;
                            border-color: accent;
                            conj-btn := TouchArea {
                                clicked => { root.show-conjugation = true; }
                            }
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                spacing: 6px;
                                Text {
                                    text: "Conjugation";
                                    vertical-alignment: center;
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: conj-btn.has-hover ? #ffffff : accent;
                                }
                                Text {
                                    text: "▸";
                                    vertical-alignment: center;
                                    font-size: 13px;
                                    color: conj-btn.has-hover ? #ffffff : accent;
                                }
                            }
                        }
                    }

                    // body: paragraphs / numbered senses (virtualized)
                    ListView {
                        vertical-stretch: 1;
                        for b[i] in def-blocks: HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            padding-top: 4px;
                            padding-bottom: 4px;
                            Text {
                                visible: b.number > 0;
                                text: b.number + ".";
                                font-size: 16px;
                                font-weight: 600;
                                color: accent;
                                width: b.number > 0 ? 24px : 0px;
                            }
                            SelectableText {
                                text: b.text;
                                font-size: 16px;
                                color: text-primary;
                                horizontal-stretch: 1;
                            }
                        }
                    }

                    // source pill (hugs its text)
                    HorizontalLayout {
                        alignment: start;
                        Rectangle {
                            visible: def-source != "";
                            height: 24px;
                            horizontal-stretch: 0;
                            border-radius: 12px;
                            background: accent-tint;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                Text {
                                    text: def-source;
                                    vertical-alignment: center;
                                    font-size: 11px;
                                    font-weight: 500;
                                    color: accent;
                                }
                            }
                        }
                    }
                }
            }
        }
        }
    }

    // ===================== settings overlay =====================
    if show-settings : Rectangle {
        // dimmed backdrop; clicking it closes the panel
        background: #00000080;
        TouchArea {
            clicked => { root.close-settings(); }
        }

        // panel (centered)
        Rectangle {
            width: min(560px, root.width - 80px);
            height: min(640px, root.height - 80px);
            background: bg;
            border-radius: 14px;
            border-width: 1px;
            border-color: divider;
            // absorb clicks so they don't fall through to the backdrop
            TouchArea {}

            VerticalLayout {
                padding: 24px;
                spacing: 14px;

                // header
                HorizontalLayout {
                    Text {
                        text: "Settings";
                        font-size: 20px;
                        font-weight: 700;
                        color: text-primary;
                        horizontal-stretch: 1;
                    }
                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 6px;
                        background: close-touch.has-hover ? divider : transparent;
                        close-touch := TouchArea {
                            clicked => { root.close-settings(); }
                        }
                        Text {
                            text: "✕";
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            color: text-secondary;
                        }
                    }
                }

                Text {
                    text: "DICTIONARIES";
                    font-size: 11px;
                    font-weight: 600;
                    color: accent;
                }

                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 8px;
                        alignment: start;
                        for d[i] in dict-items: Rectangle {
                            height: 58px;
                            border-radius: 8px;
                            background: control-bg;
                            border-width: 1px;
                            border-color: divider;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 10px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: 2px;
                                    Text {
                                        text: d.name;
                                        font-size: 14px;
                                        font-weight: 500;
                                        color: text-primary;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: d.words + " words";
                                        font-size: 12px;
                                        color: text-secondary;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    ComboBox {
                                        width: 116px;
                                        model: ["Auto", "English", "French"];
                                        current-index: d.language;
                                        selected => { root.set-dict-language(i, self.current-index); }
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Switch {
                                        checked: d.enabled;
                                        toggled => { root.toggle-dict(i); }
                                    }
                                }
                                Rectangle {
                                    width: 28px;
                                    background: remove-touch.has-hover ? divider : transparent;
                                    border-radius: 6px;
                                    remove-touch := TouchArea {
                                        clicked => { root.remove-dict(i); }
                                    }
                                    Text {
                                        text: "✕";
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        font-size: 13px;
                                        color: text-secondary;
                                    }
                                }
                            }
                        }
                    }
                }

                HorizontalLayout {
                    alignment: start;
                    Button {
                        text: "Add dictionary…";
                        clicked => { root.add-dict(); }
                    }
                }

                Text {
                    text: "APPEARANCE";
                    font-size: 11px;
                    font-weight: 600;
                    color: accent;
                }

                // theme mode segmented control
                HorizontalLayout {
                    spacing: 12px;
                    Text {
                        text: "Theme";
                        vertical-alignment: center;
                        font-size: 14px;
                        color: text-primary;
                        width: 70px;
                    }
                    Rectangle {
                        height: 30px;
                        width: 240px;
                        border-radius: 8px;
                        background: control-bg;
                        border-width: 1px;
                        border-color: divider;
                        HorizontalLayout {
                            padding: 3px;
                            spacing: 2px;
                            for seg[ti] in ["System", "Light", "Dark"]: Rectangle {
                                border-radius: 6px;
                                background: theme-mode == ti ? accent : transparent;
                                Text {
                                    text: seg;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    font-size: 13px;
                                    font-weight: theme-mode == ti ? 600 : 400;
                                    color: theme-mode == ti ? #ffffff : text-secondary;
                                }
                                TouchArea {
                                    clicked => { root.set-theme-mode(ti); }
                                }
                            }
                        }
                    }
                }

                // accent swatches (Auto + presets)
                HorizontalLayout {
                    spacing: 12px;
                    Text {
                        text: "Accent";
                        vertical-alignment: center;
                        font-size: 14px;
                        color: text-primary;
                        width: 70px;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        // "Auto" (follow the OS)
                        Rectangle {
                            width: 44px;
                            height: 28px;
                            border-radius: 8px;
                            background: control-bg;
                            border-width: accent-choice == 0 ? 2px : 1px;
                            border-color: accent-choice == 0 ? accent : divider;
                            Text {
                                text: "Auto";
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                font-size: 11px;
                                color: text-secondary;
                            }
                            TouchArea {
                                clicked => { root.set-accent(0); }
                            }
                        }
                        for sw[si] in accent-swatches: Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: 14px;
                            background: sw;
                            border-width: accent-choice == si + 1 ? 3px : 0px;
                            border-color: text-primary;
                            TouchArea {
                                clicked => { root.set-accent(si + 1); }
                            }
                        }
                    }
                }
            }
        }
    }

    // ===================== conjugation overlay =====================
    if show-conjugation : Rectangle {
        // dimmed backdrop; clicking it closes the panel
        background: #00000080;
        TouchArea {
            clicked => { root.show-conjugation = false; }
        }

        // panel (centered)
        Rectangle {
            width: min(560px, root.width - 80px);
            height: min(640px, root.height - 80px);
            background: bg;
            border-radius: 14px;
            border-width: 1px;
            border-color: divider;
            // absorb clicks so they don't fall through to the backdrop
            TouchArea {}

            VerticalLayout {
                padding: 24px;
                spacing: 14px;

                // header
                HorizontalLayout {
                    Text {
                        text: "Conjugation — " + def-headword;
                        font-size: 20px;
                        font-weight: 700;
                        color: text-primary;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 6px;
                        background: conj-close.has-hover ? divider : transparent;
                        conj-close := TouchArea {
                            clicked => { root.show-conjugation = false; }
                        }
                        Text {
                            text: "✕";
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            color: text-secondary;
                        }
                    }
                }

                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 14px;
                        alignment: start;
                        for sec in conjugation: VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: sec.label;
                                font-size: 12px;
                                font-weight: 600;
                                color: accent;
                            }
                            for f in sec.forms: HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                Text {
                                    text: f.label;
                                    font-size: 13px;
                                    color: text-secondary;
                                    width: 150px;
                                    overflow: elide;
                                }
                                SelectableText {
                                    text: f.text;
                                    font-size: 14px;
                                    font-weight: 500;
                                    color: text-primary;
                                    horizontal-stretch: 1;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
