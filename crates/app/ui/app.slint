import { ListView, ScrollView, Button, Switch, ComboBox } from "std-widgets.slint";

// Bundled IBM Plex Sans (SIL OFL). A bare file import registers the font at
// compile time so "IBM Plex Sans" is available as a font-family.
import "../assets/fonts/IBMPlexSans-400.ttf";
import "../assets/fonts/IBMPlexSans-500.ttf";
import "../assets/fonts/IBMPlexSans-600.ttf";
import "../assets/fonts/IBMPlexSans-700.ttf";

// One row in the results column: a headword plus a one-line preview.
struct ResultItem {
    headword: string,
    snippet: string,
    source: string,
}

// One row in the settings dictionary list.
struct DictRow {
    name: string,
    words: string,
    enabled: bool,
    language: int,  // 0 = Auto, 1 = English, 2 = French
}

// One downloadable dictionary in the settings "Download" section. `status` is
// 0 = available, 1 = downloading, 2 = installed; `progress` is 0..1 while
// downloading.
struct CatalogRow {
    label: string,
    detail: string,   // size + license line
    status: int,
    progress: float,
}

// One block of a definition body. `marker` is the hanging sense marker shown in
// the left column (a number like "1." or a bullet like "■"); empty for plain
// paragraphs. `text` is the plain-text variant (used for snippets); `styled` is
// the same content with cross-references converted to clickable markdown links.
struct DefBlock {
    marker: string,
    text: string,
    styled: styled-text,
    // True for an indented example/quotation, rendered in lighter italic.
    quote: bool,
    // True for a section heading (a part of speech, "Etymology"), rendered
    // bold and larger with no marker.
    heading: bool,
    // List nesting depth (0 = top level); indents nested senses.
    indent: int,
}

// One conjugated form (e.g. "past" / "went", or "je" / "parle").
struct ConjForm {
    label: string,
    text: string,
}

// One mood/tense block of a conjugation (e.g. "Indicative present",
// "Indicatif présent", …).
struct ConjSection {
    label: string,
    forms: [ConjForm],
}

// A mood tab grouping its tense sections (French: "Indicatif" → présent,
// imparfait, …). English collapses to a single mood.
struct ConjMood {
    label: string,
    sections: [ConjSection],
}

// Read-only text that the user can still select and copy (plain Text can't be
// selected in Slint).
component SelectableText inherits TextInput {
    read-only: true;
    single-line: false;
    wrap: word-wrap;
}

export component AppWindow inherits Window {
    title: "IronDict";
    icon: @image-url("../assets/icons/hicolor/256x256/apps/irondict.png");
    preferred-width: 920px;
    preferred-height: 560px;
    min-width: 640px;
    min-height: 420px;
    default-font-family: "IBM Plex Sans";
    default-font-size: 14px;
    background: bg;

    // ---- theming (accent + dark come from the OS, via Rust) ----
    // `os-accent` is the raw OS accent (defaults to indigo); `dark` mirrors the
    // OS light/dark preference. Everything else is derived so the whole palette
    // flips with one boolean.
    in property <color> os-accent: #4f46e5;
    in property <bool> dark: false;

    // Accent is brightened a touch in dark mode so it stays legible as text/lines
    // against a dark background; the tint is a translucent wash that reads
    // correctly over whatever background it is drawn on.
    property <color> accent: dark ? os-accent.brighter(0.35) : os-accent;
    property <color> accent-tint: accent.with-alpha(dark ? 0.22 : 0.12);

    property <color> bg: dark ? #1d1d20 : #ffffff;
    property <color> control-bg: dark ? #2c2c30 : #ffffff;
    property <color> text-primary: dark ? #f2f2f4 : #1c1c1e;
    property <color> text-secondary: dark ? #98989e : #8a8a8e;
    property <color> divider: dark ? #38383c : #ececec;
    property <color> toolbar-bg: dark ? #252528 : #fafafa;

    // ---- state (driven by Rust) ----
    in-out property <string> query;
    in property <[ResultItem]> results;
    in-out property <int> selected-index: 0;
    in property <bool> searching: false;
    in property <bool> index-ready: false;
    in property <bool> indexing: false;             // index build in progress
    in property <float> index-progress: 0.0;        // 0..1, drives the loading bar
    in property <string> index-status: "Indexing…"; // placeholder text while indexing
    in property <int> scope: 0;            // 0 = All, 1.. = one per dictionary
    in property <[string]> scopes: ["All"]; // segment labels (driven by Rust)

    in property <string> section-label;    // e.g. "WORD OF THE MOMENT"
    in property <string> def-headword;
    in property <string> def-pron;         // pronunciation respelling
    in property <string> def-pos;          // expanded part of speech
    in property <string> def-etym;         // etymology line (HTML entries)
    in property <[DefBlock]> def-blocks;   // definition body (paragraphs / senses)
    in property <string> def-source;

    // conjugation table (empty = the entry isn't a recognized verb). Shown only
    // on demand, in an overlay, via the button on a verb's page.
    in property <[ConjMood]> conjugation;
    // The selected mood tab; the overlay shows only that mood's tense sections.
    in-out property <int> conj-tab: 0;
    in-out property <bool> show-conjugation: false;

    // ---- settings page ----
    in-out property <bool> show-settings: false;
    in property <[DictRow]> dict-items;
    in property <[CatalogRow]> catalog-items;
    in property <int> theme-mode: 0;          // 0 System, 1 Light, 2 Dark
    in property <[color]> accent-swatches;
    in property <int> accent-choice: 0;       // 0 System, n = swatch n-1

    // Back/forward navigation through visited definition pages.
    in property <bool> can-go-back: false;
    in property <bool> can-go-forward: false;

    callback query-changed(string);
    callback select(int);
    callback scope-changed(int);
    callback lookup-token(string);
    callback navigate-back();
    callback navigate-forward();
    callback open-settings();
    callback close-settings();
    callback toggle-dict(int);
    callback set-dict-language(int, int);
    callback remove-dict(int);
    callback add-dict();
    callback download-dict(int);
    callback delete-dict(int);
    callback set-theme-mode(int);
    callback set-accent(int);

    // Focus the search field on launch; global shortcuts still bubble up to the
    // FocusScope below.
    forward-focus: search-input;
    init => {
        search-input.focus();
    }

    // Scroll the results list so row `idx` is fully visible (rows are 60px).
    function reveal-row(idx: int) {
        if (idx * 60px < -result-list.viewport-y) {
            result-list.viewport-y = -idx * 60px;
        } else if ((idx + 1) * 60px > -result-list.viewport-y + result-list.visible-height) {
            result-list.viewport-y = result-list.visible-height - (idx + 1) * 60px;
        }
    }

    // Escape (close the topmost popup) and Up/Down (move through the results).
    // Returns true when the key was handled. Shared by the search field — which
    // gets first dibs on keys while focused — and the outer FocusScope.
    function handle-nav-key(text: string, alt: bool) -> bool {
        if (text == Key.Escape) {
            if (root.show-conjugation) {
                root.show-conjugation = false;
                return true;
            }
            if (root.show-settings) {
                root.close-settings();
                return true;
            }
            return false;
        }
        // Alt+Left/Right: back/forward through the page history.
        if (alt && !root.show-settings && !root.show-conjugation) {
            if (text == Key.LeftArrow) {
                root.navigate-back();
                return true;
            }
            if (text == Key.RightArrow) {
                root.navigate-forward();
                return true;
            }
        }
        if (!root.show-settings && !root.show-conjugation && root.results.length > 0) {
            if (text == Key.DownArrow) {
                root.select(Math.min(root.selected-index + 1, root.results.length - 1));
                root.reveal-row(root.selected-index);
                return true;
            }
            if (text == Key.UpArrow) {
                root.select(Math.max(root.selected-index - 1, 0));
                root.reveal-row(root.selected-index);
                return true;
            }
        }
        return false;
    }

    FocusScope {
        key-pressed(event) => {
            if (root.handle-nav-key(event.text, event.modifiers.alt)) {
                return EventResult.accept;
            }
            // Ctrl+1 = All, Ctrl+2 = first dictionary, …; Ctrl+Tab cycles.
            if (event.modifiers.control && event.text >= "1" && event.text <= "9") {
                // text is a single digit here; map "1" → index 0, etc.
                root.scope-changed(event.text.to-float() - 1);
                return EventResult.accept;
            }
            if (event.modifiers.control && event.text == Key.Tab) {
                root.scope-changed(Math.mod(root.scope + 1, root.scopes.length));
                return EventResult.accept;
            }
            return EventResult.reject;
        }

        // Map the mouse back/forward buttons onto page navigation. The scrollable
        // body (Flickable) forwards non-left buttons, so this outer TouchArea
        // still sees them while reading a definition.
        TouchArea {
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    if (event.button == PointerEventButton.back) {
                        root.navigate-back();
                    } else if (event.button == PointerEventButton.forward) {
                        root.navigate-forward();
                    }
                }
            }

        VerticalLayout {
        // ===================== toolbar =====================
        Rectangle {
            height: 52px;
            background: toolbar-bg;

            // scope segmented control (left) — one segment per scope label,
            // sized to its contents so it grows as dictionaries are added.
            Rectangle {
                x: 16px;
                y: (parent.height - self.height) / 2;
                height: 30px;
                width: scope-row.preferred-width;
                border-radius: 8px;
                background: control-bg;
                border-width: 1px;
                border-color: divider;
                scope-row := HorizontalLayout {
                    padding: 3px;
                    spacing: 2px;
                    for seg[idx] in root.scopes: Rectangle {
                        max-width: 180px;
                        border-radius: 6px;
                        background: scope == idx ? accent : transparent;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            Text {
                                text: seg;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                font-size: 13px;
                                font-weight: scope == idx ? 600 : 400;
                                color: scope == idx ? #ffffff : text-secondary;
                                overflow: elide;
                            }
                        }
                        TouchArea {
                            clicked => { root.scope-changed(idx); }
                        }
                    }
                }
            }

            // settings gear (far right)
            Rectangle {
                x: parent.width - self.width - 16px;
                y: (parent.height - self.height) / 2;
                width: 32px;
                height: 32px;
                border-radius: 8px;
                background: gear-touch.has-hover ? divider : transparent;
                gear-touch := TouchArea {
                    clicked => { root.open-settings(); }
                }
                Text {
                    text: "⚙";
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    font-size: 18px;
                    color: text-secondary;
                }
            }

            // search field (right, left of the gear)
            Rectangle {
                x: parent.width - self.width - 16px - 32px - 10px;
                y: (parent.height - self.height) / 2;
                height: 32px;
                width: 260px;
                border-radius: 8px;
                background: control-bg;
                // Subtle at rest, accent ring on focus (colour only, so the inner
                // content doesn't shift when focus changes).
                border-width: 1px;
                border-color: search-input.has-focus ? accent : divider;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 8px;
                    spacing: 7px;
                    // Leading search glyph, tinted to the accent while focused.
                    Text {
                        width: 16px;
                        text: "⌕";
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        font-size: 17px;
                        color: search-input.has-focus ? accent : text-secondary;
                    }
                    // Text area: stretches to fill, with the input and placeholder
                    // both pinned left so the caret starts here (not centered).
                    Rectangle {
                        horizontal-stretch: 1;
                        clip: true;
                        // Placeholder sits underneath, left-aligned to match the
                        // input; hidden as soon as the user types.
                        Text {
                            x: 0;
                            width: parent.width;
                            visible: root.query == "";
                            text: root.index-ready ? "Search…" : root.index-status;
                            horizontal-alignment: left;
                            vertical-alignment: center;
                            font-size: 14px;
                            color: text-secondary;
                        }
                        search-input := TextInput {
                            x: 0;
                            width: parent.width;
                            horizontal-alignment: left;
                            vertical-alignment: center;
                            font-size: 14px;
                            color: text-primary;
                            single-line: true;
                            text <=> root.query;
                            edited => { root.query-changed(self.text); }
                            // Intercept Esc/Up/Down here: a focused TextInput's
                            // key-pressed runs before it consumes the arrows for
                            // cursor movement, so the FocusScope never sees them.
                            key-pressed(event) => {
                                root.handle-nav-key(event.text, event.modifiers.alt)
                                    ? EventResult.accept
                                    : EventResult.reject;
                            }
                        }
                    }
                    // Clear button, shown only while there's a query.
                    Rectangle {
                        width: 18px;
                        visible: root.query != "";
                        border-radius: 9px;
                        background: clear-touch.has-hover ? divider : transparent;
                        clear-touch := TouchArea {
                            clicked => {
                                root.query = "";
                                root.query-changed("");
                                search-input.focus();
                            }
                        }
                        Text {
                            text: "✕";
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            font-size: 11px;
                            color: clear-touch.has-hover ? text-primary : text-secondary;
                        }
                    }
                }
            }

            // bottom hairline
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: divider;
            }
        }

        // ===================== indexing bar =====================
        // A thin accent line under the toolbar while the search index is
        // (re)building, growing left-to-right; the percentage / time remaining
        // rides along in the search-box placeholder.
        if root.indexing : Rectangle {
            height: 3px;
            background: divider;
            Rectangle {
                x: 0;
                width: parent.width * root.index-progress;
                height: parent.height;
                background: accent;
                animate width { duration: 200ms; easing: ease-out; }
            }
        }

        // ===================== body =====================
        HorizontalLayout {
            // results column (always visible)
            Rectangle {
                width: 244px;
                background: bg;
                result-list := ListView {
                    for item[i] in results: Rectangle {
                        height: 60px;
                        background: i == root.selected-index ? accent-tint : transparent;

                        // accent left bar on the selected row
                        Rectangle {
                            x: 0;
                            width: 3px;
                            background: i == root.selected-index ? accent : transparent;
                        }
                        TouchArea {
                            clicked => { root.select(i); }
                        }
                        VerticalLayout {
                            padding-left: 17px;
                            padding-right: 12px;
                            padding-top: 11px;
                            padding-bottom: 11px;
                            spacing: 3px;
                            HorizontalLayout {
                                spacing: 6px;
                                Text {
                                    text: item.headword;
                                    font-size: 14px;
                                    font-weight: 500;
                                    color: text-primary;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                                // source label — only useful when searching all
                                // dictionaries (scope 0); a scoped search makes
                                // every row the same dictionary.
                                Text {
                                    visible: root.scope == 0 && item.source != "";
                                    text: item.source;
                                    font-size: 11px;
                                    font-weight: 500;
                                    color: accent;
                                    vertical-alignment: center;
                                    horizontal-stretch: 0;
                                }
                            }
                            Text {
                                text: item.snippet;
                                font-size: 12px;
                                color: text-secondary;
                                overflow: elide;
                            }
                        }
                    }
                }

                // divider between list and definition
                Rectangle {
                    x: parent.width - 1px;
                    width: 1px;
                    background: divider;
                }
            }

            // definition pane (the hero). The header/pill stay fixed; only the
            // body scrolls — and it is a ListView so huge entries (e.g. 60 KB
            // HTML dictionary entries) are virtualized and stay at 60fps.
            Rectangle {
                horizontal-stretch: 1;
                background: bg;
                VerticalLayout {
                    padding-left: 40px;
                    padding-right: 40px;
                    padding-top: 36px;
                    padding-bottom: 28px;
                    spacing: 10px;

                    // Hidden header lines use `if` (not `visible`) so they reserve
                    // no layout space — otherwise the gap below the headword grows
                    // for entries without a pos/etymology/conjugation.
                    if section-label != "" : Text {
                        text: section-label;
                        color: accent;
                        font-size: 11px;
                        font-weight: 600;
                    }
                    headword-sel := SelectableText {
                        text: def-headword;
                        font-size: 30px;
                        font-weight: 600;
                        color: text-primary;
                    }
                    // part of speech + pronunciation on one grey line
                    if def-pos != "" || def-pron != "" : HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        if def-pos != "" : Text {
                            text: def-pos;
                            font-size: 13px;
                            font-italic: true;
                            color: text-secondary;
                        }
                        if def-pron != "" : Text {
                            text: def-pos != "" ? "· " + def-pron : def-pron;
                            font-size: 13px;
                            color: text-secondary;
                        }
                    }
                    // etymology (HTML entries) on its own grey line
                    if def-etym != "" : Text {
                        text: def-etym;
                        font-size: 13px;
                        color: text-secondary;
                        wrap: word-wrap;
                    }

                    // conjugation button (verbs only): opens the full tables in
                    // an overlay so they never crowd out the definition body.
                    if conjugation.length > 0 : HorizontalLayout {
                        alignment: start;
                        Rectangle {
                            height: 30px;
                            horizontal-stretch: 0;
                            border-radius: 8px;
                            background: conj-btn.has-hover ? accent : accent-tint;
                            border-width: 1px;
                            border-color: accent;
                            conj-btn := TouchArea {
                                clicked => { root.show-conjugation = true; }
                            }
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                spacing: 6px;
                                Text {
                                    text: "Conjugation";
                                    vertical-alignment: center;
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: conj-btn.has-hover ? #ffffff : accent;
                                }
                                Text {
                                    text: "▸";
                                    vertical-alignment: center;
                                    font-size: 13px;
                                    color: conj-btn.has-hover ? #ffffff : accent;
                                }
                            }
                        }
                    }

                    // body: paragraphs / numbered senses (virtualized).
                    // Each block renders as markdown so cross-references like
                    // {tenir} become clickable inline links.
                    ListView {
                        vertical-stretch: 1;
                        for b[i] in def-blocks: HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            // headings get extra breathing room above the section
                            padding-top: b.heading ? 14px : (b.quote ? 2px : 4px);
                            padding-bottom: b.quote ? 2px : 4px;
                            // nested senses indent under their parent; quotations
                            // hang a little further in than their sense body
                            padding-left: b.indent * 20px + (b.quote ? 24px : 0px);
                            Text {
                                visible: b.marker != "";
                                text: b.marker;
                                font-size: 16px;
                                font-weight: 600;
                                color: accent;
                                width: b.marker != "" ? 24px : 0px;
                            }
                            // Section heading (part of speech / "Etymology").
                            if b.heading : Text {
                                text: b.text;
                                font-size: 18px;
                                font-weight: 700;
                                color: text-primary;
                                horizontal-stretch: 1;
                            }
                            if !b.quote && !b.heading : StyledText {
                                text: b.styled;
                                default-color: text-primary;
                                link-color: accent;
                                horizontal-stretch: 1;
                                link-clicked(link) => {
                                    root.lookup-token(link);
                                }
                            }
                            // Quotation/example: lighter italic prose. Slint can't
                            // mix font runs in a styled-text, so quotes are a plain
                            // italic Text rather than the markdown StyledText above.
                            if b.quote : Text {
                                text: b.text;
                                font-italic: true;
                                font-size: 15px;
                                color: text-secondary;
                                wrap: word-wrap;
                                horizontal-stretch: 1;
                            }
                        }
                    }

                    // source pill (hugs its text)
                    HorizontalLayout {
                        alignment: start;
                        Rectangle {
                            visible: def-source != "";
                            height: 24px;
                            horizontal-stretch: 0;
                            border-radius: 12px;
                            background: accent-tint;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                Text {
                                    text: def-source;
                                    vertical-alignment: center;
                                    font-size: 11px;
                                    font-weight: 500;
                                    color: accent;
                                }
                            }
                        }
                    }
                }
            }
        }
        }
        }
    }

    // ===================== settings overlay =====================
    if show-settings : Rectangle {
        // dimmed backdrop; clicking it closes the panel
        background: #00000080;
        TouchArea {
            clicked => { root.close-settings(); }
        }

        // panel (centered)
        Rectangle {
            // Which settings panel is shown: 0 Dictionaries, 1 Downloads,
            // 2 Appearance. Local UI state — not persisted.
            property <int> active-panel: 0;
            width: min(720px, root.width - 80px);
            height: min(640px, root.height - 80px);
            background: bg;
            border-radius: 14px;
            border-width: 1px;
            border-color: divider;
            // absorb clicks so they don't fall through to the backdrop
            TouchArea {}

            VerticalLayout {
                padding: 24px;
                spacing: 16px;

                // header
                HorizontalLayout {
                    Text {
                        text: "Settings";
                        font-size: 20px;
                        font-weight: 700;
                        color: text-primary;
                        horizontal-stretch: 1;
                    }
                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 6px;
                        background: close-touch.has-hover ? divider : transparent;
                        close-touch := TouchArea {
                            clicked => { root.close-settings(); }
                        }
                        Text {
                            text: "✕";
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            color: text-secondary;
                        }
                    }
                }

                // body: sidebar nav + the active panel's content
                HorizontalLayout {
                    spacing: 20px;

                    // sidebar
                    VerticalLayout {
                        width: 150px;
                        spacing: 4px;
                        alignment: start;
                        for item[ni] in ["Dictionaries", "Downloads", "Appearance"]: Rectangle {
                            height: 36px;
                            border-radius: 8px;
                            background: active-panel == ni
                                ? divider
                                : (nav-touch.has-hover ? control-bg : transparent);
                            HorizontalLayout {
                                padding-left: 12px;
                                Text {
                                    text: item;
                                    vertical-alignment: center;
                                    font-size: 14px;
                                    font-weight: active-panel == ni ? 600 : 400;
                                    color: active-panel == ni ? accent : text-primary;
                                }
                            }
                            nav-touch := TouchArea {
                                clicked => { active-panel = ni; }
                            }
                        }
                    }

                    // ---- Dictionaries panel ----
                    if active-panel == 0 : VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 12px;
                        ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                spacing: 8px;
                                alignment: start;
                                for d[i] in dict-items: Rectangle {
                                    height: 58px;
                                    border-radius: 8px;
                                    background: control-bg;
                                    border-width: 1px;
                                    border-color: divider;
                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        spacing: 10px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            spacing: 2px;
                                            Text {
                                                text: d.name;
                                                font-size: 14px;
                                                font-weight: 500;
                                                color: text-primary;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: d.words + " words";
                                                font-size: 12px;
                                                color: text-secondary;
                                            }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            ComboBox {
                                                width: 116px;
                                                model: ["Auto", "English", "French", "Italian"];
                                                current-index: d.language;
                                                selected => { root.set-dict-language(i, self.current-index); }
                                            }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            Switch {
                                                checked: d.enabled;
                                                toggled => { root.toggle-dict(i); }
                                            }
                                        }
                                        Rectangle {
                                            width: 28px;
                                            background: remove-touch.has-hover ? divider : transparent;
                                            border-radius: 6px;
                                            remove-touch := TouchArea {
                                                clicked => { root.remove-dict(i); }
                                            }
                                            Text {
                                                text: "✕";
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                                font-size: 13px;
                                                color: text-secondary;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        HorizontalLayout {
                            alignment: start;
                            Button {
                                text: "Add dictionary…";
                                clicked => { root.add-dict(); }
                            }
                        }
                    }

                    // ---- Downloads panel ----
                    if active-panel == 1 : VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 12px;
                        ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                spacing: 8px;
                                alignment: start;
                                for c[i] in catalog-items: Rectangle {
                                    height: 50px;
                                    border-radius: 8px;
                                    background: control-bg;
                                    border-width: 1px;
                                    border-color: divider;
                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        spacing: 10px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            spacing: 2px;
                                            Text {
                                                text: c.label;
                                                font-size: 14px;
                                                font-weight: 500;
                                                color: text-primary;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: c.status == 1
                                                    ? "Downloading… " + Math.round(c.progress * 100) + "%"
                                                    : c.detail;
                                                font-size: 12px;
                                                color: text-secondary;
                                            }
                                        }
                                        if c.status == 2: HorizontalLayout {
                                            spacing: 6px;
                                            Text {
                                                text: "✓ Installed";
                                                font-size: 13px;
                                                color: text-secondary;
                                                vertical-alignment: center;
                                            }
                                            Rectangle {
                                                width: 28px;
                                                border-radius: 6px;
                                                background: delete-touch.has-hover ? divider : transparent;
                                                delete-touch := TouchArea {
                                                    clicked => { root.delete-dict(i); }
                                                }
                                                Text {
                                                    text: "🗑";
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                    font-size: 13px;
                                                    color: text-secondary;
                                                }
                                            }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            if c.status != 2: Rectangle {
                                                width: 96px;
                                                height: 30px;
                                                border-radius: 6px;
                                                background: c.status == 1
                                                    ? divider
                                                    : (dl-touch.has-hover ? accent : control-bg);
                                                border-width: 1px;
                                                border-color: divider;
                                                Text {
                                                    text: c.status == 1 ? Math.round(c.progress * 100) + "%" : "Download";
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                    font-size: 13px;
                                                    color: (dl-touch.has-hover && c.status == 0) ? #ffffff : text-primary;
                                                }
                                                dl-touch := TouchArea {
                                                    enabled: c.status == 0;
                                                    clicked => { root.download-dict(i); }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ---- Appearance panel ----
                    if active-panel == 2 : VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 16px;
                        alignment: start;

                        // theme mode segmented control
                        HorizontalLayout {
                            spacing: 12px;
                            Text {
                                text: "Theme";
                                vertical-alignment: center;
                                font-size: 14px;
                                color: text-primary;
                                width: 70px;
                            }
                            Rectangle {
                                height: 30px;
                                width: 240px;
                                border-radius: 8px;
                                background: control-bg;
                                border-width: 1px;
                                border-color: divider;
                                HorizontalLayout {
                                    padding: 3px;
                                    spacing: 2px;
                                    for seg[ti] in ["System", "Light", "Dark"]: Rectangle {
                                        border-radius: 6px;
                                        background: theme-mode == ti ? accent : transparent;
                                        Text {
                                            text: seg;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            font-size: 13px;
                                            font-weight: theme-mode == ti ? 600 : 400;
                                            color: theme-mode == ti ? #ffffff : text-secondary;
                                        }
                                        TouchArea {
                                            clicked => { root.set-theme-mode(ti); }
                                        }
                                    }
                                }
                            }
                        }

                        // accent swatches (Auto + presets)
                        HorizontalLayout {
                            spacing: 12px;
                            Text {
                                text: "Accent";
                                vertical-alignment: center;
                                font-size: 14px;
                                color: text-primary;
                                width: 70px;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                // "Auto" (follow the OS)
                                Rectangle {
                                    width: 44px;
                                    height: 28px;
                                    border-radius: 8px;
                                    background: control-bg;
                                    border-width: accent-choice == 0 ? 2px : 1px;
                                    border-color: accent-choice == 0 ? accent : divider;
                                    Text {
                                        text: "Auto";
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        font-size: 11px;
                                        color: text-secondary;
                                    }
                                    TouchArea {
                                        clicked => { root.set-accent(0); }
                                    }
                                }
                                for sw[si] in accent-swatches: Rectangle {
                                    width: 28px;
                                    height: 28px;
                                    border-radius: 14px;
                                    background: sw;
                                    border-width: accent-choice == si + 1 ? 3px : 0px;
                                    border-color: text-primary;
                                    TouchArea {
                                        clicked => { root.set-accent(si + 1); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ===================== conjugation overlay =====================
    if show-conjugation : Rectangle {
        // dimmed backdrop; clicking it closes the panel
        background: #00000080;
        TouchArea {
            clicked => { root.show-conjugation = false; }
        }

        // panel (centered)
        Rectangle {
            width: min(620px, root.width - 80px);
            height: min(640px, root.height - 80px);
            background: bg;
            border-radius: 14px;
            border-width: 1px;
            border-color: divider;
            // absorb clicks so they don't fall through to the backdrop
            TouchArea {}

            VerticalLayout {
                padding: 24px;
                spacing: 14px;

                // header
                HorizontalLayout {
                    Text {
                        text: "Conjugation — " + def-headword;
                        font-size: 20px;
                        font-weight: 700;
                        color: text-primary;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 6px;
                        background: conj-close.has-hover ? divider : transparent;
                        conj-close := TouchArea {
                            clicked => { root.show-conjugation = false; }
                        }
                        Text {
                            text: "✕";
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            color: text-secondary;
                        }
                    }
                }

                // body: mood tabs on the left, the active mood's tenses right
                HorizontalLayout {
                    spacing: 20px;
                    vertical-stretch: 1;

                    // mood tabs (hidden when there's only one, e.g. English)
                    if conjugation.length > 1 : VerticalLayout {
                        width: 140px;
                        spacing: 4px;
                        alignment: start;
                        for mood[ti] in conjugation: Rectangle {
                            height: 36px;
                            border-radius: 8px;
                            background: conj-tab == ti
                                ? divider
                                : (mood-touch.has-hover ? control-bg : transparent);
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                Text {
                                    text: mood.label;
                                    vertical-alignment: center;
                                    font-size: 14px;
                                    font-weight: conj-tab == ti ? 600 : 400;
                                    color: conj-tab == ti ? accent : text-primary;
                                    overflow: elide;
                                }
                            }
                            mood-touch := TouchArea {
                                clicked => {
                                    conj-tab = ti;
                                    // start the new mood's tenses from the top
                                    conj-scroll.viewport-y = 0;
                                }
                            }
                        }
                    }

                    conj-scroll := ScrollView {
                        horizontal-stretch: 1;
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 14px;
                            alignment: start;
                            for sec in conjugation[conj-tab].sections : VerticalLayout {
                                spacing: 4px;
                                Text {
                                    text: sec.label;
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: accent;
                                }
                                for f in sec.forms: HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    Text {
                                        text: f.label;
                                        font-size: 13px;
                                        color: text-secondary;
                                        width: 150px;
                                        overflow: elide;
                                    }
                                    SelectableText {
                                        text: f.text;
                                        font-size: 14px;
                                        font-weight: 500;
                                        color: text-primary;
                                        horizontal-stretch: 1;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
