import { ListView, ScrollView, Button, Switch, ComboBox, Palette } from "std-widgets.slint";

// Bundled IBM Plex Sans (SIL OFL). A bare file import registers the font at
// compile time so "IBM Plex Sans" is available as a font-family.
import "../assets/fonts/IBMPlexSans-400.ttf";
import "../assets/fonts/IBMPlexSans-500.ttf";
import "../assets/fonts/IBMPlexSans-600.ttf";
import "../assets/fonts/IBMPlexSans-700.ttf";

// One row in the results column: a headword plus a one-line preview.
struct ResultItem {
    headword: string,
    snippet: string,
    source: string,
}

// One row in the settings dictionary list.
struct DictRow {
    name: string,
    words: string,
    enabled: bool,
    language: int,  // 0 = Auto, 1 = English, 2 = French
}

// One downloadable dictionary in the settings "Download" section. `status` is
// 0 = available, 1 = downloading, 2 = installed; `progress` is 0..1 while
// downloading.
struct CatalogRow {
    label: string,
    detail: string,   // size + license line
    status: int,
    progress: float,
}

// One block of a definition body. `marker` is the hanging sense marker shown in
// the left column (a number like "1." or a bullet like "■"); empty for plain
// paragraphs. `text` is the plain-text variant (used for snippets); `styled` is
// the same content with cross-references converted to clickable markdown links.
struct DefBlock {
    marker: string,
    text: string,
    styled: styled-text,
    // True for an indented example/quotation, rendered in lighter italic.
    quote: bool,
    // True for a section heading (a part of speech, "Etymology"), rendered
    // bold and larger with no marker.
    heading: bool,
    // List nesting depth (0 = top level); indents nested senses.
    indent: int,
    // True for the trailing "Conjugation" button (verb entries), rendered at the
    // end of the body; opens the conjugation overlay.
    conj: bool,
}

// One conjugated form (e.g. "past" / "went", or "je" / "parle").
struct ConjForm {
    label: string,
    text: string,
}

// One mood/tense block of a conjugation (e.g. "Indicative present",
// "Indicatif présent", …).
struct ConjSection {
    label: string,
    forms: [ConjForm],
}

// A mood tab grouping its tense sections (French: "Indicatif" → présent,
// imparfait, …). English collapses to a single mood.
struct ConjMood {
    label: string,
    sections: [ConjSection],
}

// Read-only text that the user can still select and copy (plain Text can't be
// selected in Slint).
// A SwipeGestureHandler that hosts content as children. With a plain
// `TouchArea {}` behind the content, unpressed moves are accepted, so a nested
// vertical ScrollView still receives the delayed press and can scroll while
// horizontal swipes are handled here.
component SwipePanel inherits SwipeGestureHandler {
    @children
}

// One settings panel (0 Dictionaries, 1 Downloads, 2 Appearance). Used once on
// desktop and as the three pages of the narrow swipe carousel.
component SettingsPanelBody inherits Rectangle {
    in property <int> index: 0;
    in property <bool> narrow: false;
    in property <[DictRow]> dict-items;
    in property <bool> can-add-local: true;
    in property <[CatalogRow]> catalog-items;
    in property <int> theme-mode: 0;
    in property <int> accent-choice: 0;
    in property <[color]> accent-swatches;
    in property <color> accent;
    in property <color> accent-tint;
    in property <color> bg;
    in property <color> control-bg;
    in property <color> text-primary;
    in property <color> text-secondary;
    in property <color> divider;
    callback set-dict-language(int, int);
    callback toggle-dict(int);
    callback remove-dict(int);
    callback add-dict();
    callback delete-dict(int);
    callback download-dict(int);
    callback set-theme-mode(int);
    callback set-accent(int);

                    if index == 0 : VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 12px;
                        ScrollView {
                            vertical-stretch: 1;
                            // never pan sideways: material's ComboBox is wide
                            // and its preferred width can add a few px.
                            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                            VerticalLayout {
                                spacing: 8px;
                                alignment: start;
                                for d[i] in dict-items: Rectangle {
                                    height: 58px;
                                    border-radius: 8px;
                                    background: control-bg;
                                    border-width: 1px;
                                    border-color: divider;
                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        spacing: 10px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            spacing: 2px;
                                            Text {
                                                text: d.name;
                                                font-size: 14px;
                                                font-weight: 500;
                                                color: text-primary;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: d.words + " words";
                                                font-size: 12px;
                                                color: text-secondary;
                                            }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            ComboBox {
                                                // material's ComboBox has wider
                                                // padding + an arrow, so the phone
                                                // width must be bigger to fit
                                                // "English" without eliding.
                                                // material's ComboBox defaults to a
                                                // 160px min-width and stretch, which
                                                // overflows the settings row (and
                                                // shows a horizontal scrollbar). Pin
                                                // both min and preferred width, and
                                                // stop it from stretching.
                                                min-width: narrow ? 132px : 116px;
                                                preferred-width: narrow ? 132px : 116px;
                                                horizontal-stretch: 0;
                                                model: ["Auto", "English", "French", "Italian"];
                                                current-index: d.language;
                                                selected => { set-dict-language(i, self.current-index); }
                                            }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            Switch {
                                                checked: d.enabled;
                                                toggled => { toggle-dict(i); }
                                            }
                                        }
                                        Rectangle {
                                            width: narrow ? 44px : 28px;
                                            background: remove-touch.has-hover ? divider : transparent;
                                            border-radius: 6px;
                                            remove-touch := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { remove-dict(i); }
                                            }
                                            Text {
                                                text: "×";
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                                font-size: 18px;
                                                color: text-secondary;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        if can-add-local : HorizontalLayout {
                            alignment: start;
                            Button {
                                text: "Add dictionary…";
                                clicked => { add-dict(); }
                            }
                        }
                    }

                    // ---- Downloads panel ----
                    if index == 1 : VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 12px;
                        ScrollView {
                            vertical-stretch: 1;
                            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                            VerticalLayout {
                                spacing: 8px;
                                alignment: start;
                                for c[i] in catalog-items: Rectangle {
                                    height: 50px;
                                    border-radius: 8px;
                                    background: control-bg;
                                    border-width: 1px;
                                    border-color: divider;
                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        spacing: 10px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            spacing: 2px;
                                            Text {
                                                text: c.label;
                                                font-size: 14px;
                                                font-weight: 500;
                                                color: text-primary;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: c.status == 1
                                                    ? "Downloading… " + Math.round(c.progress * 100) + "%"
                                                    : c.detail;
                                                font-size: 12px;
                                                color: text-secondary;
                                            }
                                        }
                                        if c.status == 2: HorizontalLayout {
                                            spacing: 6px;
                                            Text {
                                                text: "Installed";
                                                font-size: 13px;
                                                color: text-secondary;
                                                vertical-alignment: center;
                                            }
                                            Rectangle {
                                                width: narrow ? 44px : 28px;
                                                border-radius: 6px;
                                                background: delete-touch.has-hover ? divider : transparent;
                                                delete-touch := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => { delete-dict(i); }
                                                }
                                                Text {
                                                    text: "×";
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                    font-size: 18px;
                                                    color: text-secondary;
                                                }
                                            }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            if c.status != 2: Rectangle {
                                                width: 96px;
                                                height: 30px;
                                                border-radius: 6px;
                                                background: c.status == 1
                                                    ? divider
                                                    : (dl-touch.has-hover ? accent : control-bg);
                                                border-width: 1px;
                                                border-color: divider;
                                                Text {
                                                    text: c.status == 1 ? Math.round(c.progress * 100) + "%" : "Download";
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                    font-size: 13px;
                                                    color: (dl-touch.has-hover && c.status == 0) ? #ffffff : text-primary;
                                                }
                                                dl-touch := TouchArea {
                                                    enabled: c.status == 0;
                                                    mouse-cursor: self.enabled ? pointer : default;
                                                    clicked => { download-dict(i); }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ---- Appearance panel ----
                    if index == 2 : VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 16px;
                        alignment: start;

                        // theme mode segmented control
                        HorizontalLayout {
                            spacing: 12px;
                            Text {
                                text: "Theme";
                                vertical-alignment: center;
                                font-size: 14px;
                                color: text-primary;
                                width: 70px;
                            }
                            Rectangle {
                                height: 30px;
                                width: 240px;
                                border-radius: 8px;
                                background: control-bg;
                                border-width: 1px;
                                border-color: divider;
                                HorizontalLayout {
                                    padding: 3px;
                                    spacing: 2px;
                                    for seg[ti] in ["System", "Light", "Dark"]: Rectangle {
                                        border-radius: 6px;
                                        background: theme-mode == ti ? accent : transparent;
                                        Text {
                                            text: seg;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            font-size: 13px;
                                            font-weight: theme-mode == ti ? 600 : 400;
                                            color: theme-mode == ti ? #ffffff : text-secondary;
                                        }
                                        TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { set-theme-mode(ti); }
                                        }
                                    }
                                }
                            }
                        }

                        // accent swatches (Auto + presets)
                        HorizontalLayout {
                            spacing: 12px;
                            Text {
                                text: "Accent";
                                vertical-alignment: center;
                                font-size: 14px;
                                color: text-primary;
                                width: 70px;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                // "Auto" (follow the OS)
                                Rectangle {
                                    width: 44px;
                                    height: 28px;
                                    border-radius: 8px;
                                    background: control-bg;
                                    border-width: accent-choice == 0 ? 2px : 1px;
                                    border-color: accent-choice == 0 ? accent : divider;
                                    Text {
                                        text: "Auto";
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        font-size: 11px;
                                        color: text-secondary;
                                    }
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { set-accent(0); }
                                    }
                                }
                                for sw[si] in accent-swatches: Rectangle {
                                    width: 28px;
                                    height: 28px;
                                    border-radius: 14px;
                                    background: sw;
                                    border-width: accent-choice == si + 1 ? 3px : 0px;
                                    border-color: text-primary;
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { set-accent(si + 1); }
                                    }
                                }
                            }
                        }
                    }
}

component SelectableText inherits TextInput {
    read-only: true;
    single-line: false;
    wrap: word-wrap;
}

// The "All"/dictionary scope segmented control. Shared by the desktop toolbar
// and the narrow-mode second toolbar row (where it scrolls horizontally).
component ScopeBar inherits Rectangle {
    in property <[string]> scopes: ["All"];
    in property <int> scope: 0;
    in property <color> accent;
    in property <color> text-secondary;
    in property <color> control-bg;
    in property <color> divider;
    callback selected(int);

    width: scope-row.preferred-width;
    height: 34px;
    border-radius: 8px;
    background: control-bg;
    border-width: 1px;
    border-color: divider;
    scope-row := HorizontalLayout {
        padding: 3px;
        spacing: 2px;
        for seg[idx] in scopes: Rectangle {
            max-width: 180px;
            border-radius: 6px;
            background: scope == idx ? accent : transparent;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                Text {
                    text: seg;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    font-size: 13px;
                    font-weight: scope == idx ? 600 : 400;
                    color: scope == idx ? #ffffff : text-secondary;
                    overflow: elide;
                }
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => { selected(idx); }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "IronDict";
    icon: @image-url("../assets/icons/hicolor/256x256/apps/irondict.png");
    preferred-width: 920px;
    preferred-height: 560px;
    min-width: 320px;
    min-height: 420px;
    default-font-family: "IBM Plex Sans";
    default-font-size: 14px;
    background: bg;

    // Narrow (phone) layout: collapse the two-pane desktop view into a single
    // pane and stack the toolbar. `narrow-def` is true while that pane shows the
    // definition rather than the result list. Set imperatively (not as a binding)
    // to avoid a layout binding loop through the window width.
    in-out property <bool> narrow: false;
    changed width => { root.narrow = self.width < 600px; }
    in-out property <bool> narrow-def: true;
    // Current vertical scroll of the results list. Kept on the root so keyboard
    // navigation can move it without reaching into a conditional element.
    in-out property <length> list-scroll-y: 0;
    // On Android the soft keyboard must not pop up at launch, so focus the outer
    // scope (which still receives Back) instead of the search field; the desktop
    // build calls `focus-search` right after creating the window.
    public function focus-search() {
        search-input.focus();
    }

    // ---- theming (accent + dark come from the OS, via Rust) ----
    // `os-accent` is the raw OS accent (defaults to indigo); `dark` mirrors the
    // OS light/dark preference. Everything else is derived so the whole palette
    // flips with one boolean.
    in property <color> os-accent: #4f46e5;
    in property <bool> dark: false;
    // On Android the system scheme arrives through Slint's built-in `Palette`;
    // while the user hasn't forced a mode we follow it instead of `dark`.
    in property <bool> follow-system: false;
    property <bool> dark-mode: follow-system ? Palette.color-scheme == ColorScheme.dark : dark;

    // Accent is brightened a touch in dark mode so it stays legible as text/lines
    // against a dark background; the tint is a translucent wash that reads
    // correctly over whatever background it is drawn on.
    property <color> accent: dark-mode ? os-accent.brighter(0.35) : os-accent;
    property <color> accent-tint: accent.with-alpha(dark-mode ? 0.22 : 0.12);

    property <color> bg: dark-mode ? #1d1d20 : #ffffff;
    property <color> control-bg: dark-mode ? #2c2c30 : #ffffff;
    property <color> text-primary: dark-mode ? #f2f2f4 : #1c1c1e;
    property <color> text-secondary: dark-mode ? #98989e : #8a8a8e;
    property <color> divider: dark-mode ? #38383c : #ececec;
    property <color> toolbar-bg: dark-mode ? #252528 : #fafafa;

    // Whether the "Add dictionary…" button is shown. Local file import needs a
    // filesystem path and a native picker, so it is hidden on Android.
    in property <bool> can-add-local: true;

    // ---- state (driven by Rust) ----
    in-out property <string> query;
    // `query` plus any in-progress IME composition (preedit). Slint keeps preedit
    // out of `text` until the IME commits, so search/placeholder use this instead.
    property <string> live-query: root.query + search-input.preedit-text;
    // Body scroll offset, so a new page can reset it to the top without reaching
    // into the (conditionally instantiated) definition pane.
    in-out property <length> def-scroll-y;
    in property <[ResultItem]> results;
    in-out property <int> selected-index: 0;
    in property <bool> searching: false;
    in property <bool> indexing: false;             // index build in progress
    in property <float> index-progress: 0.0;        // 0..1, drives the loading bar
    in property <string> index-status: "Indexing…"; // placeholder text while indexing
    in property <int> scope: 0;            // 0 = All, 1.. = one per dictionary
    in property <[string]> scopes: ["All"]; // segment labels (driven by Rust)

    in property <string> section-label;    // e.g. "WORD OF THE MOMENT"
    in property <string> def-headword;
    in property <string> def-pron;         // pronunciation respelling
    in property <string> def-etym;         // etymology line (HTML entries)
    in property <[DefBlock]> def-blocks;   // definition body (paragraphs / senses)
    in property <string> def-source;

    // conjugation table (empty = the entry isn't a recognized verb). Shown only
    // on demand, in an overlay, via the button on a verb's page.
    in property <[ConjMood]> conjugation;
    // Localized "Conjugation" word for the button/overlay, matching the verb's
    // language (e.g. "Conjugaison" for French).
    in property <string> conj-label: "Conjugation";
    // The selected mood tab; the overlay shows only that mood's tense sections.
    in-out property <int> conj-tab: 0;
    // Narrow conjugation carousel: page offset and page width, plus the desktop
    // scroll offset the mood sidebar resets.
    in-out property <length> conj-page-x: 0;
    property <length> conj-page-w: root.width - 32px;
    // 0 while a finger is dragging (so the page tracks it 1:1), animated for a
    // tab tap or the post-drag snap.
    in-out property <bool> conj-dragging: false;
    animate conj-page-x { duration: conj-dragging ? 0ms : 280ms; easing: ease-out; }
    in-out property <length> conj-scroll-y: 0;
    in-out property <bool> show-conjugation: false;

    // ---- settings page ----
    in-out property <bool> show-settings: false;
    in property <[DictRow]> dict-items;
    in property <[CatalogRow]> catalog-items;
    in property <int> theme-mode: 0;          // 0 System, 1 Light, 2 Dark
    in property <[color]> accent-swatches;
    in property <int> accent-choice: 0;       // 0 System, n = swatch n-1

    // Settings tab (0 Dictionaries, 1 Downloads, 2 Appearance) and the narrow
    // carousel offset. At the root so the tab bar and the carousel — which live
    // in separate `if` branches — share it. While dragging, the offset follows
    // the finger; otherwise changes animate (tab taps, snap).
    in-out property <int> active-panel: 0;
    in-out property <length> settings-page-x: 0;
    property <length> settings-page-w: root.width - 32px;
    property <bool> settings-dragging: false;
    animate settings-page-x { duration: settings-dragging ? 0ms : 280ms; easing: ease-out; }

    // Back/forward navigation through visited definition pages.
    in property <bool> can-go-back: false;
    in property <bool> can-go-forward: false;

    callback query-changed(string);
    callback select(int);
    callback scope-changed(int);
    callback lookup-token(string);
    callback navigate-back();
    callback navigate-forward();
    callback open-settings();
    callback close-settings();
    callback toggle-dict(int);
    callback set-dict-language(int, int);
    callback remove-dict(int);
    callback add-dict();
    callback download-dict(int);
    callback delete-dict(int);
    callback set-theme-mode(int);
    callback set-accent(int);

    // Focus the outer scope so Back is delivered without raising the soft
    // keyboard; desktop focuses the search field via `focus-search`.
    init => {
        root.narrow = root.width < 600px;
        nav-scope.focus();
    }

    // Feed in-progress IME composition into the search as it is typed; when the
    // IME commits, `edited` fires with the full text as usual.
    changed live-query => {
        if (search-input.preedit-text != "") {
            // Composing text doesn't fire `edited`, so reveal the results list
            // here too (otherwise typing while reading a definition keeps the
            // definition pane showing the first match).
            root.narrow-def = false;
            root.query-changed(root.live-query);
        }
    }

    // New page → jump the body back to the top. The old ListView did this on
    // its own; the ScrollView doesn't.
    changed def-headword => {
        root.def-scroll-y = 0;
    }

    // Opening the conjugation overlay starts at the first mood; the narrow
    // carousel's viewport-x defaults to 0, so keep the tab in sync.
    changed show-conjugation => {
        if (show-conjugation) {
            conj-tab = 0;
            root.conj-page-x = 0;
        }
    }

    changed conj-tab => {
        root.conj-page-x = -conj-tab * root.conj-page-w;
    }

    changed active-panel => {
        root.settings-page-x = -active-panel * root.settings-page-w;
    }

    // Scroll the results list so row `idx` is fully visible (rows are 60px).
    function reveal-row(idx: int) {
        let row = 60px;
        // Approximate viewport height (window minus toolbars and insets).
        let vh = Math.max(root.height - 200px, 120px);
        if (idx * row < -root.list-scroll-y) {
            root.list-scroll-y = -idx * row;
        } else if ((idx + 1) * row > -root.list-scroll-y + vh) {
            root.list-scroll-y = vh - (idx + 1) * row;
        }
    }

    // Escape (close the topmost popup) and Up/Down (move through the results).
    // Returns true when the key was handled. Shared by the search field — which
    // gets first dibs on keys while focused — and the outer FocusScope.
    function handle-nav-key(text: string, alt: bool) -> bool {
        if (text == Key.Escape) {
            if (root.show-conjugation) {
                root.show-conjugation = false;
                return true;
            }
            if (root.show-settings) {
                root.close-settings();
                return true;
            }
            return false;
        }
        // Android Back: close the topmost layer, then leave a narrow-mode
        // definition for the result list, then history back. Reject when nothing
        // is left, so Android's default finishes the activity.
        if (text == Key.Back) {
            if (root.show-conjugation) {
                root.show-conjugation = false;
                return true;
            }
            if (root.show-settings) {
                root.close-settings();
                return true;
            }
            if (root.narrow && root.narrow-def) {
                root.narrow-def = false;
                return true;
            }
            if (root.can-go-back) {
                root.navigate-back();
                return true;
            }
            return false;
        }
        // Alt+Left/Right: back/forward through the page history.
        if (alt && !root.show-settings && !root.show-conjugation) {
            if (text == Key.LeftArrow) {
                root.navigate-back();
                return true;
            }
            if (text == Key.RightArrow) {
                root.navigate-forward();
                return true;
            }
        }
        if (!root.show-settings && !root.show-conjugation && root.results.length > 0
            && (!root.narrow || !root.narrow-def)) {
            if (text == Key.DownArrow) {
                root.select(Math.min(root.selected-index + 1, root.results.length - 1));
                root.reveal-row(root.selected-index);
                return true;
            }
            if (text == Key.UpArrow) {
                root.select(Math.max(root.selected-index - 1, 0));
                root.reveal-row(root.selected-index);
                return true;
            }
        }
        return false;
    }

    nav-scope := FocusScope {
        width: root.width;
        height: root.height;
        key-pressed(event) => {
            if (root.handle-nav-key(event.text, event.modifiers.alt)) {
                return EventResult.accept;
            }
            // Ctrl+1 = All, Ctrl+2 = first dictionary, …; Ctrl+Tab cycles.
            if (event.modifiers.control && event.text >= "1" && event.text <= "9") {
                // text is a single digit here; map "1" → index 0, etc.
                root.scope-changed(event.text.to-float() - 1);
                return EventResult.accept;
            }
            if (event.modifiers.control && event.text == Key.Tab) {
                root.scope-changed(Math.mod(root.scope + 1, root.scopes.length));
                return EventResult.accept;
            }
            return EventResult.reject;
        }

        // Map the mouse back/forward buttons onto page navigation. The scrollable
        // body (Flickable) forwards non-left buttons, so this outer TouchArea
        // still sees them while reading a definition.
        TouchArea {
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    if (event.button == PointerEventButton.back) {
                        root.navigate-back();
                    } else if (event.button == PointerEventButton.forward) {
                        root.navigate-forward();
                    }
                }
            }

        VerticalLayout {
        // Keep the whole UI clear of the status bar, gesture bar and display
        // cutout. Zero on desktop.
        padding-left: root.safe-area-insets.left;
        padding-right: root.safe-area-insets.right;
        padding-top: root.safe-area-insets.top;
        padding-bottom: root.safe-area-insets.bottom;
        // ===================== toolbar =====================
        Rectangle {
            height: 52px;
            background: toolbar-bg;

            // scope segmented control (desktop: inline; narrow: second row)
            ScopeBar {
                x: 16px;
                y: (parent.height - self.height) / 2;
                visible: !root.narrow;
                scopes: root.scopes;
                scope: root.scope;
                accent: accent;
                text-secondary: text-secondary;
                control-bg: control-bg;
                divider: divider;
                selected(idx) => { root.narrow-def = false; root.scope-changed(idx); }
            }

            // settings gear (far right)
            Rectangle {
                x: parent.width - self.width - (root.narrow ? 8px : 16px);
                y: (parent.height - self.height) / 2;
                width: root.narrow ? 44px : 32px;
                height: root.narrow ? 44px : 32px;
                border-radius: 8px;
                background: gear-touch.has-hover ? divider : transparent;
                gear-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.open-settings(); }
                }
                Image {
                    x: (parent.width - 20px) / 2;
                    y: (parent.height - 20px) / 2;
                    width: 20px;
                    height: 20px;
                    source: @image-url("icons/gear.svg");
                    colorize: text-secondary;
                }
            }

            // search field (right, left of the gear)
            Rectangle {
                x: root.narrow ? 12px : parent.width - self.width - 16px - 32px - 10px;
                y: (parent.height - self.height) / 2;
                height: root.narrow ? 40px : 32px;
                width: root.narrow ? parent.width - 72px : 260px;
                border-radius: 8px;
                background: control-bg;
                // Subtle at rest, accent ring on focus (colour only, so the inner
                // content doesn't shift when focus changes).
                border-width: 1px;
                border-color: search-input.has-focus ? accent : divider;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 8px;
                    spacing: 7px;
                    // Leading search glyph, tinted to the accent while focused.
                    // (A stretched box with the icon absolutely centered, so it lines
                    // up with the text regardless of the field height.)
                    Rectangle {
                        width: 16px;
                        vertical-stretch: 1;
                        Image {
                            x: 0;
                            y: (parent.height - 16px) / 2;
                            width: 16px;
                            height: 16px;
                            source: @image-url("icons/search.svg");
                            colorize: search-input.has-focus ? accent : text-secondary;
                        }
                    }
                    // Text area: stretches to fill, with the input and placeholder
                    // both pinned left so the caret starts here (not centered).
                    Rectangle {
                        horizontal-stretch: 1;
                        clip: true;
                        // Placeholder sits underneath, left-aligned to match the
                        // input; hidden as soon as the user types.
                        Text {
                            x: 0;
                            width: parent.width;
                            visible: root.live-query == "";
                            // "Indexing…" only during a real (re)build; otherwise
                            // a plain prompt, including the brief startup window
                            // where the engine is opening its cached index.
                            text: root.indexing ? root.index-status : "Search…";
                            horizontal-alignment: left;
                            vertical-alignment: center;
                            font-size: 14px;
                            color: text-secondary;
                        }
                        search-input := TextInput {
                            x: 0;
                            width: parent.width;
                            horizontal-alignment: left;
                            vertical-alignment: center;
                            font-size: 14px;
                            color: text-primary;
                            single-line: true;
                            text <=> root.query;
                            edited => { root.narrow-def = false; root.query-changed(self.text); }
                            // Intercept Esc/Up/Down here: a focused TextInput's
                            // key-pressed runs before it consumes the arrows for
                            // cursor movement, so the FocusScope never sees them.
                            key-pressed(event) => {
                                root.handle-nav-key(event.text, event.modifiers.alt)
                                    ? EventResult.accept
                                    : EventResult.reject;
                            }
                        }
                    }
                    // Clear button, shown only while there's a query.
                    Rectangle {
                        width: root.narrow ? 44px : 18px;
                        border-radius: root.narrow ? 10px : 9px;
                        visible: root.live-query != "";
                        background: clear-touch.has-hover ? divider : transparent;
                        clear-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                // On Android the IME keeps the in-progress word as
                                // preedit, which `query = ""` can't clear. Drop
                                // focus first so the backend commits the preedit
                                // into `text`, then clear and refocus.
                                search-input.clear-focus();
                                root.query = "";
                                root.narrow-def = true;
                                root.query-changed("");
                                search-input.focus();
                            }
                        }
                        Text {
                            text: "×";
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            font-size: 15px;
                            color: clear-touch.has-hover ? text-primary : text-secondary;
                        }
                    }
                }
            }

            // bottom hairline
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: divider;
            }
        }

        // ===================== narrow scope row =====================
        // The toolbar's scope segments, on their own horizontally scrollable row
        // so the search field can take the full width on a phone.
        if root.narrow : Rectangle {
            height: 44px;
            background: toolbar-bg;
            Flickable {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                interactive: true;
                viewport-width: scope-content.preferred-width + 24px;
                viewport-height: parent.height;
                scope-content := HorizontalLayout {
                    x: 12px;
                    y: 5px;
                    ScopeBar {
                        scopes: root.scopes;
                        scope: root.scope;
                        accent: accent;
                        text-secondary: text-secondary;
                        control-bg: control-bg;
                        divider: divider;
                        selected(idx) => { root.narrow-def = false; root.scope-changed(idx); }
                    }
                }
            }
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: divider;
            }
        }

        // ===================== indexing bar =====================
        // A thin accent line under the toolbar while the search index is
        // (re)building, growing left-to-right; the percentage / time remaining
        // rides along in the search-box placeholder.
        if root.indexing : Rectangle {
            height: 3px;
            background: divider;
            Rectangle {
                x: 0;
                width: parent.width * root.index-progress;
                height: parent.height;
                background: accent;
                animate width { duration: 200ms; easing: ease-out; }
            }
        }

        // ===================== body =====================
        HorizontalLayout {
            // results column (desktop always; narrow only while searching, so the
            // definition can use the full width)
            if !root.narrow || !root.narrow-def : Rectangle {
                preferred-width: root.narrow ? 0px : 244px;
                horizontal-stretch: root.narrow ? 1 : 0;
                background: bg;
                result-list := ListView {
                    viewport-y <=> root.list-scroll-y;
                    for item[i] in results: Rectangle {
                        height: 60px;
                        background: i == root.selected-index ? accent-tint : transparent;

                        // accent left bar on the selected row
                        Rectangle {
                            x: 0;
                            width: 3px;
                            background: i == root.selected-index ? accent : transparent;
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.select(i);
                                root.narrow-def = true;
                                // Hide the soft keyboard on Android.
                                if (root.narrow) { nav-scope.focus(); }
                            }
                        }
                        VerticalLayout {
                            padding-left: 17px;
                            padding-right: 12px;
                            padding-top: 11px;
                            padding-bottom: 11px;
                            spacing: 3px;
                            HorizontalLayout {
                                spacing: 6px;
                                Text {
                                    text: item.headword;
                                    font-size: 14px;
                                    font-weight: 500;
                                    color: text-primary;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                                // source label — only useful when searching all
                                // dictionaries (scope 0); a scoped search makes
                                // every row the same dictionary.
                                Text {
                                    visible: root.scope == 0 && item.source != "";
                                    text: item.source;
                                    font-size: 11px;
                                    font-weight: 500;
                                    color: accent;
                                    vertical-alignment: center;
                                    horizontal-stretch: 0;
                                }
                            }
                            Text {
                                text: item.snippet;
                                font-size: 12px;
                                color: text-secondary;
                                overflow: elide;
                            }
                        }
                    }
                }

                // divider between list and definition
                Rectangle {
                    x: parent.width - 1px;
                    width: 1px;
                    visible: !root.narrow;
                    background: divider;
                }
            }

            // definition pane (the hero). The header/pill stay fixed; only the
            // body scrolls. The body is a ScrollView over a plain VerticalLayout
            // so block heights are exact (a ListView re-estimates them mid-fling
            // and makes long entries jump).
            if !root.narrow || root.narrow-def : Rectangle {
                horizontal-stretch: 1;
                background: bg;
                VerticalLayout {
                    padding-left: root.narrow ? 16px : 40px;
                    padding-right: root.narrow ? 16px : 40px;
                    padding-top: root.narrow ? 12px : 36px;
                    padding-bottom: 28px;
                    spacing: 10px;

                    // (No on-screen Back button: the system Back key/gesture
                    // returns from a narrow definition to the result list.)

                    // Hidden header lines use `if` (not `visible`) so they reserve
                    // no layout space — otherwise the gap below the headword grows
                    // for entries without a pos/etymology/conjugation.
                    if section-label != "" : Text {
                        text: section-label;
                        color: accent;
                        font-size: 11px;
                        font-weight: 600;
                    }
                    headword-sel := SelectableText {
                        text: def-headword;
                        font-size: root.narrow ? 24px : 30px;
                        font-weight: 600;
                        color: text-primary;
                    }
                    // pronunciation on its own grey line (the part of speech is now
                    // rendered as a heading above each section of the body)
                    if def-pron != "" : Text {
                        text: def-pron;
                        font-size: 13px;
                        color: text-secondary;
                    }
                    // etymology (HTML entries) on its own grey line
                    if def-etym != "" : Text {
                        text: def-etym;
                        font-size: 13px;
                        color: text-secondary;
                        wrap: word-wrap;
                    }

                    // body: paragraphs / numbered senses. A ScrollView (not a
                    // ListView) so exact heights are known up front: a ListView
                    // re-estimates item heights during a fling, which makes long
                    // entries jump. Material's ScrollView pans on touch too.
                    def-scroll := ScrollView {
                        vertical-stretch: 1;
                        horizontal-stretch: 1;
                        viewport-y <=> root.def-scroll-y;
                        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                        VerticalLayout {
                            // Match the flickable's inner width exactly so the body
                            // can never pan sideways by the scrollbar's reserve.
                            width: def-scroll.visible-width;
                            // pack rows at their natural height; the default
                            // `stretch` would spread the viewport's spare space
                            // between rows (huge gaps on short entries).
                            alignment: start;
                            for b[i] in def-blocks: HorizontalLayout {
                            width: parent.width;
                            spacing: 8px;
                            alignment: start;
                            // headings and the trailing button get extra breathing
                            // room above them
                            padding-top: b.heading || b.conj ? 14px : (b.quote ? 2px : 4px);
                            padding-bottom: b.quote ? 2px : 4px;
                            // nested senses indent under their parent; quotations
                            // hang a little further in than their sense body
                            padding-left: b.indent * 20px + (b.quote ? 24px : 0px);
                            Text {
                                visible: b.marker != "";
                                text: b.marker;
                                font-size: 16px;
                                font-weight: 600;
                                color: accent;
                                width: b.marker != "" ? 24px : 0px;
                            }
                            // Section heading (part of speech / "Etymology").
                            if b.heading : Text {
                                text: b.text;
                                font-size: 18px;
                                font-weight: 700;
                                color: text-primary;
                                horizontal-stretch: 1;
                            }
                            // Trailing "Conjugation" button (verb entries): opens
                            // the full tables in an overlay so they never crowd out
                            // the definition body.
                            if b.conj : Rectangle {
                                height: 30px;
                                horizontal-stretch: 0;
                                border-radius: 8px;
                                background: conj-btn.has-hover ? accent : accent-tint;
                                border-width: 1px;
                                border-color: accent;
                                conj-btn := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.show-conjugation = true; }
                                }
                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    spacing: 6px;
                                    Text {
                                        text: root.conj-label;
                                        vertical-alignment: center;
                                        font-size: 13px;
                                        font-weight: 600;
                                        color: conj-btn.has-hover ? #ffffff : accent;
                                    }
                                    Text {
                                        text: ">";
                                        vertical-alignment: center;
                                        font-size: 13px;
                                        color: conj-btn.has-hover ? #ffffff : accent;
                                    }
                                }
                            }
                            if !b.quote && !b.heading && !b.conj : StyledText {
                                text: b.styled;
                                default-color: text-primary;
                                link-color: accent;
                                horizontal-stretch: 1;
                                link-clicked(link) => {
                                    root.lookup-token(link);
                                }
                            }
                            // Quotation/example: lighter italic prose. Slint can't
                            // mix font runs in a styled-text, so quotes are a plain
                            // italic Text rather than the markdown StyledText above.
                            if b.quote : Text {
                                text: b.text;
                                font-italic: true;
                                font-size: 15px;
                                color: text-secondary;
                                wrap: word-wrap;
                                horizontal-stretch: 1;
                            }
                        }
                        }
                    }

                    // source pill (hugs its text)
                    HorizontalLayout {
                        alignment: start;
                        Rectangle {
                            visible: def-source != "";
                            height: 24px;
                            horizontal-stretch: 0;
                            border-radius: 12px;
                            background: accent-tint;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                Text {
                                    text: def-source;
                                    vertical-alignment: center;
                                    font-size: 11px;
                                    font-weight: 500;
                                    color: accent;
                                }
                            }
                        }
                    }
                }
            }
        }
        }
        }
    }

    // ===================== settings overlay =====================
    if show-settings : Rectangle {
        // dimmed backdrop; clicking it closes the panel
        background: #00000080;
        TouchArea {
            clicked => { root.close-settings(); }
        }

        // panel (centered)
        Rectangle {
            // 0 Dictionaries, 1 Downloads, 2 Appearance (root property).
            width: root.narrow ? root.width : min(720px, root.width - 80px);
            height: root.narrow ? root.height : min(640px, root.height - 80px);
            background: bg;
            border-radius: root.narrow ? 0px : 14px;
            border-width: 1px;
            border-color: divider;
            // absorb clicks so they don't fall through to the backdrop
            TouchArea {}

            VerticalLayout {
                    padding-left: root.narrow ? 16px : 24px;
                    padding-right: root.narrow ? 16px : 24px;
                    padding-top: root.narrow ? (12px + root.safe-area-insets.top) : 24px;
                    padding-bottom: root.narrow ? (12px + root.safe-area-insets.bottom) : 24px;
                    spacing: 16px;

                // header
                HorizontalLayout {
                    Text {
                        text: "Settings";
                        font-size: 20px;
                        font-weight: 700;
                        color: text-primary;
                        horizontal-stretch: 1;
                    }
                    Rectangle {
                        width: root.narrow ? 44px : 28px;
                        height: root.narrow ? 44px : 28px;
                        border-radius: 6px;
                        background: close-touch.has-hover ? divider : transparent;
                        close-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.close-settings(); }
                        }
                        Text {
                            text: "×";
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            font-size: root.narrow ? 24px : 18px;
                            color: text-secondary;
                        }
                    }
                }

                // narrow: settings sections as top tabs
                if root.narrow : HorizontalLayout {
                    spacing: 4px;
                    for item[ni] in ["Dictionaries", "Downloads", "Appearance"]: Rectangle {
                        height: 36px;
                        horizontal-stretch: 1;
                        border-radius: 8px;
                        background: active-panel == ni ? divider : transparent;
                        Text {
                            text: item;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            font-size: 12px;
                            font-weight: active-panel == ni ? 600 : 400;
                            color: active-panel == ni ? accent : text-primary;
                            overflow: elide;
                        }
                        top-tab-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { active-panel = ni; }
                        }
                    }
                }

                // body: sidebar nav + the active panel's content
                HorizontalLayout {
                    spacing: 20px;

                    // sidebar (desktop; narrow uses the tabs above)
                    if !root.narrow : VerticalLayout {
                        width: 150px;
                        spacing: 4px;
                        alignment: start;
                        for item[ni] in ["Dictionaries", "Downloads", "Appearance"]: Rectangle {
                            height: 36px;
                            border-radius: 8px;
                            background: active-panel == ni
                                ? divider
                                : (nav-touch.has-hover ? control-bg : transparent);
                            HorizontalLayout {
                                padding-left: 12px;
                                Text {
                                    text: item;
                                    vertical-alignment: center;
                                    font-size: 14px;
                                    font-weight: active-panel == ni ? 600 : 400;
                                    color: active-panel == ni ? accent : text-primary;
                                }
                            }
                            nav-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { active-panel = ni; }
                            }
                        }
                    }

                    // desktop: the active panel
                    if !root.narrow : SettingsPanelBody {
                        index: active-panel;
                        narrow: root.narrow;
                        dict-items: root.dict-items;
                        can-add-local: root.can-add-local;
                        catalog-items: root.catalog-items;
                        theme-mode: root.theme-mode;
                        accent-choice: root.accent-choice;
                        accent-swatches: root.accent-swatches;
                        accent: accent;
                        accent-tint: accent-tint;
                        bg: bg;
                        control-bg: control-bg;
                        text-primary: text-primary;
                        text-secondary: text-secondary;
                        divider: divider;
                        set-dict-language(i, l) => { root.set-dict-language(i, l); }
                        toggle-dict(i) => { root.toggle-dict(i); }
                        remove-dict(i) => { root.remove-dict(i); }
                        add-dict() => { root.add-dict(); }
                        delete-dict(i) => { root.delete-dict(i); }
                        download-dict(i) => { root.download-dict(i); }
                        set-theme-mode(m) => { root.set-theme-mode(m); }
                        set-accent(a) => { root.set-accent(a); }
                    }

                    // narrow: the three panels side by side in a Flickable so the
                    // page follows the finger; it snaps to the nearest after the
                    // drag settles.
                    if root.narrow : settings-swipe := SwipePanel {
                        horizontal-stretch: 1;
                        vertical-stretch: 1;
                        handle-swipe-left: true;
                        handle-swipe-right: true;
                        moved => {
                            if (self.swiping) {
                                root.settings-dragging = true;
                                let base = -(active-panel * settings-swipe.width);
                                let raw = base + (self.current-position.x - self.pressed-position.x);
                                let min-x = -(settings-swipe.width * 2);
                                root.settings-page-x = raw < min-x ? min-x : (raw > 0px ? 0px : raw);
                            }
                        }
                        swiped => {
                            root.settings-dragging = false;
                            let dx = self.current-position.x - self.pressed-position.x;
                            let w = settings-swipe.width;
                            if (dx < -(w / 3) && active-panel < 2) {
                                active-panel += 1;
                            } else if (dx > w / 3 && active-panel > 0) {
                                active-panel -= 1;
                            }
                            root.settings-page-x = -(active-panel * w);
                        }
                        cancelled => {
                            root.settings-dragging = false;
                            root.settings-page-x = -(active-panel * settings-swipe.width);
                        }
                        // Accepts unpressed moves so the nested ScrollViews keep
                        // scrolling while this handler watches for horizontal swipes.
                        TouchArea {
                            width: parent.width;
                            height: parent.height;
                        }
                        Rectangle {
                            width: parent.width;
                            height: parent.height;
                            clip: true;
                            Rectangle {
                                x: root.settings-page-x;
                                width: settings-swipe.width * 3;
                                height: parent.height;
                                for idx in [0, 1, 2] : SettingsPanelBody {
                                    index: idx;
                                    narrow: root.narrow;
                                    x: idx * settings-swipe.width;
                                    width: settings-swipe.width;
                                    height: parent.height;
                                    dict-items: root.dict-items;
                                    can-add-local: root.can-add-local;
                                    catalog-items: root.catalog-items;
                                    theme-mode: root.theme-mode;
                                    accent-choice: root.accent-choice;
                                    accent-swatches: root.accent-swatches;
                                    accent: accent;
                                    accent-tint: accent-tint;
                                    bg: bg;
                                    control-bg: control-bg;
                                    text-primary: text-primary;
                                    text-secondary: text-secondary;
                                    divider: divider;
                                    set-dict-language(i, l) => { root.set-dict-language(i, l); }
                                    toggle-dict(i) => { root.toggle-dict(i); }
                                    remove-dict(i) => { root.remove-dict(i); }
                                    add-dict() => { root.add-dict(); }
                                    delete-dict(i) => { root.delete-dict(i); }
                                    download-dict(i) => { root.download-dict(i); }
                                    set-theme-mode(m) => { root.set-theme-mode(m); }
                                    set-accent(a) => { root.set-accent(a); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ===================== conjugation overlay =====================
    if show-conjugation : Rectangle {
        // dimmed backdrop; clicking it closes the panel
        background: #00000080;
        TouchArea {
            clicked => { root.show-conjugation = false; }
        }

        // panel (centered)
        Rectangle {
            width: root.narrow ? root.width : min(620px, root.width - 80px);
            height: root.narrow ? root.height : min(640px, root.height - 80px);
            background: bg;
            border-radius: root.narrow ? 0px : 14px;
            border-width: 1px;
            border-color: divider;
            // absorb clicks so they don't fall through to the backdrop
            TouchArea {}

            VerticalLayout {
                    padding-left: root.narrow ? 16px : 24px;
                    padding-right: root.narrow ? 16px : 24px;
                    padding-top: root.narrow ? (12px + root.safe-area-insets.top) : 24px;
                    padding-bottom: root.narrow ? (12px + root.safe-area-insets.bottom) : 24px;
                    spacing: 14px;

                // header
                HorizontalLayout {
                    Text {
                        text: root.conj-label + " — " + def-headword;
                        font-size: 20px;
                        font-weight: 700;
                        color: text-primary;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    Rectangle {
                        width: root.narrow ? 44px : 28px;
                        height: root.narrow ? 44px : 28px;
                        border-radius: 6px;
                        background: conj-close.has-hover ? divider : transparent;
                        conj-close := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.show-conjugation = false; }
                        }
                        Text {
                            text: "×";
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            font-size: root.narrow ? 24px : 18px;
                            color: text-secondary;
                        }
                    }
                }

                // narrow: mood tabs across the top
                if root.narrow && conjugation.length > 1 : HorizontalLayout {
                    spacing: 4px;
                    for mood[ti] in conjugation: Rectangle {
                        height: 36px;
                        horizontal-stretch: 1;
                        border-radius: 8px;
                        background: conj-tab == ti ? divider : transparent;
                        Text {
                            text: mood.label;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            font-size: 12px;
                            font-weight: conj-tab == ti ? 600 : 400;
                            color: conj-tab == ti ? accent : text-primary;
                            overflow: elide;
                        }
                        mood-top-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { conj-tab = ti; }
                        }
                    }
                }

                // body: mood tabs on the left (desktop), or a swipeable mood
                // carousel (narrow). The carousel is a horizontal Flickable with
                // one page per mood, so a swipe flips between moods and each page
                // keeps its own vertical scroll position.
                HorizontalLayout {
                    spacing: 20px;
                    vertical-stretch: 1;

                    // mood tabs (hidden when there's only one, e.g. English; and
                    // on narrow, where they move above)
                    if !root.narrow && conjugation.length > 1 : VerticalLayout {
                        width: 140px;
                        spacing: 4px;
                        alignment: start;
                        for mood[ti] in conjugation: Rectangle {
                            height: 36px;
                            border-radius: 8px;
                            background: conj-tab == ti
                                ? divider
                                : (mood-touch.has-hover ? control-bg : transparent);
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                Text {
                                    text: mood.label;
                                    vertical-alignment: center;
                                    font-size: 14px;
                                    font-weight: conj-tab == ti ? 600 : 400;
                                    color: conj-tab == ti ? accent : text-primary;
                                    overflow: elide;
                                }
                            }
                            mood-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    conj-tab = ti;
                                    // start the new mood's tenses from the top
                                    root.conj-scroll-y = 0;
                                }
                            }
                        }
                    }

                    // desktop: the active mood's tenses
                    if !root.narrow : ScrollView {
                        horizontal-stretch: 1;
                        vertical-stretch: 1;
                        viewport-y <=> root.conj-scroll-y;
                        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                        VerticalLayout {
                            spacing: 14px;
                            alignment: start;
                            for sec in conjugation[conj-tab].sections : VerticalLayout {
                                spacing: 4px;
                                Text {
                                    text: sec.label;
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: accent;
                                }
                                for f in sec.forms: HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    Text {
                                        text: f.label;
                                        font-size: 13px;
                                        color: text-secondary;
                                        width: 150px;
                                        overflow: elide;
                                    }
                                    SelectableText {
                                        text: f.text;
                                        font-size: 14px;
                                        font-weight: 500;
                                        color: text-primary;
                                        horizontal-stretch: 1;
                                    }
                                }
                            }
                        }
                    }

                    // narrow: one page per mood, swipe left/right to change mood
                    if root.narrow : conj-swipe := SwipePanel {
                        horizontal-stretch: 1;
                        vertical-stretch: 1;
                        handle-swipe-left: true;
                        handle-swipe-right: true;
                        moved => {
                            if (self.swiping) {
                                root.conj-dragging = true;
                                let base = -(conj-tab * conj-swipe.width);
                                let raw = base + (self.current-position.x - self.pressed-position.x);
                                let min-x = -((conjugation.length - 1) * conj-swipe.width);
                                root.conj-page-x = raw < min-x ? min-x : (raw > 0px ? 0px : raw);
                            }
                        }
                        swiped => {
                            root.conj-dragging = false;
                            let dx = self.current-position.x - self.pressed-position.x;
                            let w = conj-swipe.width;
                            if (dx < -(w / 3) && conj-tab < conjugation.length - 1) {
                                conj-tab += 1;
                            } else if (dx > w / 3 && conj-tab > 0) {
                                conj-tab -= 1;
                            }
                            root.conj-page-x = -(conj-tab * w);
                        }
                        cancelled => {
                            root.conj-dragging = false;
                            root.conj-page-x = -(conj-tab * conj-swipe.width);
                        }
                        // Accepts unpressed moves so the nested ScrollViews keep
                        // scrolling while this handler watches for horizontal swipes.
                        TouchArea {
                            width: parent.width;
                            height: parent.height;
                        }
                        Rectangle {
                            width: parent.width;
                            height: parent.height;
                            clip: true;
                            Rectangle {
                                x: root.conj-page-x;
                                width: conj-swipe.width * conjugation.length;
                                height: parent.height;
                                for mood[ti] in conjugation: ScrollView {
                                x: ti * conj-swipe.width;
                                width: conj-swipe.width;
                                height: parent.height;
                                horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                                VerticalLayout {
                                    spacing: 14px;
                                    alignment: start;
                                    for sec in mood.sections : VerticalLayout {
                                        spacing: 4px;
                                        Text {
                                            text: sec.label;
                                            font-size: 12px;
                                            font-weight: 600;
                                            color: accent;
                                        }
                                        for f in sec.forms: HorizontalLayout {
                                            spacing: 8px;
                                            alignment: start;
                                            Text {
                                                text: f.label;
                                                font-size: 13px;
                                                color: text-secondary;
                                                width: 150px;
                                                overflow: elide;
                                            }
                                            SelectableText {
                                                text: f.text;
                                                font-size: 14px;
                                                font-weight: 500;
                                                color: text-primary;
                                                horizontal-stretch: 1;
                                            }
                                        }
                                    }
                                }
                            }
                            }
                        }
                    }
                }
            }
        }
    }
}
